{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nura-landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@workspace/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "nura-mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@workspace/web",
        "run",
        "dev:lan"
      ],
      "port": 3000
    }
  ]
}
