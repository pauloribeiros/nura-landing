# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored — never commit it,
# and never paste these values into a chat, an issue or a screenshot.
# ---------------------------------------------------------------------------

# Absolute origin for canonical, og:url, sitemap and JSON-LD.
# On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL automatically;
# set it once a custom domain exists. No trailing slash.
SITE_URL=https://nuraperfil.com

# --- Supabase --------------------------------------------------------------
# Naming follows the current dashboard: publishable / secret replaced the
# older anon / service_role. The publishable key is meant to reach the
# browser; what protects the data is row level security, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses row level security entirely. Server only — if this ever
# appears in a NEXT_PUBLIC_ variable or in client code, rotate it immediately.
SUPABASE_SECRET_KEY=

# SECRET. Two connection strings, on purpose.
# DATABASE_URL is the transaction pooler (6543) the app uses at runtime.
# DIRECT_URL is the session pooler (5432) migrations need, because transaction
# mode does not hold DDL or prepared statements reliably.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- PostHog (analytics) ---------------------------------------------------
# Optional. Without a key, consent still works but events go nowhere — dev
# builds log them to the console. Events only ever fire after the visitor
# accepts the consent banner (LGPD).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Stripe (payments) -----------------------------------------------------
# SECRET. Without it the checkout route answers 503 and everything else keeps
# working — the assessment and the free result do not depend on payments.
STRIPE_SECRET_KEY=

# SECRET. Signs the webhook. This is the entire security model of the webhook
# endpoint: without verification, a forged POST would hand out paid reports.
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) --------------------------------------------------------
# SECRET. Without it nothing else fails — a purchase completes and the report
# is reachable in the browser that bought it; only the receipt does not go out.
RESEND_API_KEY=

# Must be a domain verified in Resend. The default sandbox sender only
# delivers to the Resend account owner, so real customers need a real domain.
RESEND_FROM=NURA <ola@send.nuraperfil.com>

# Mostra "mais rapido que X%" nas telas do teste de QI com um percentil
# SIMULADO, tirado de uma curva normal e nao de participantes reais.
# Serve para avaliar o funil. Ver src/domain/iq/percentilSimulado.ts.
NEXT_PUBLIC_IQ_PERCENTIL_SIMULADO=0

# Liga o atalho ?fim=1 na pagina do teste de QI, que cria uma corrida com
# uma resposta e vai direto para as telas finais. So para teste.
NEXT_PUBLIC_IQ_PREVIEW=0

# Chave PUBLICA do Stripe (pk_test_... ou pk_live_...). E publica por
# desenho: e ela que monta os campos de cartao do Payment Element no
# navegador. Sem ela a pagina de pagamento nao abre o formulario.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
