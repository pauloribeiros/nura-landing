# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored — never commit it,
# and never paste these values into a chat, an issue or a screenshot.
# ---------------------------------------------------------------------------

# Absolute origin for canonical, og:url, sitemap and JSON-LD.
# On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL automatically;
# set it once a custom domain exists. No trailing slash.
SITE_URL=https://nura.example.com

# --- Supabase --------------------------------------------------------------
# Naming follows the current dashboard: publishable / secret replaced the
# older anon / service_role. The publishable key is meant to reach the
# browser; what protects the data is row level security, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses row level security entirely. Server only — if this ever
# appears in a NEXT_PUBLIC_ variable or in client code, rotate it immediately.
SUPABASE_SECRET_KEY=

# SECRET. Two connection strings, on purpose.
# DATABASE_URL is the transaction pooler (6543) the app uses at runtime.
# DIRECT_URL is the session pooler (5432) migrations need, because transaction
# mode does not hold DDL or prepared statements reliably.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
