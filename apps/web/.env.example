# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored — never commit it,
# and never paste these values into a chat, an issue or a screenshot.
# ---------------------------------------------------------------------------

# Absolute origin for canonical, og:url, sitemap and JSON-LD.
# On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL automatically;
# set it once a custom domain exists. No trailing slash.
SITE_URL=https://nura.example.com

# --- Supabase --------------------------------------------------------------
# Both NEXT_PUBLIC_ values are meant to reach the browser. They are not
# secrets: what protects the data is row level security, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security entirely. Server only — if this ever
# appears in a NEXT_PUBLIC_ variable or in client code, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Postgres connection for Drizzle migrations.
# Use the POOLED connection string (Supavisor, transaction mode, port 6543).
# A direct connection exhausts Postgres under serverless traffic.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
